    "build:debug": "napi build --platform --js index.js --dts index.d.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^25.2.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "texture-bridge.*.node"
  ],
  "license": "MIT"
}
