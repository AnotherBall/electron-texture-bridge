{
  "name": "@electron-texture-bridge/native",
  "version": "0.1.0",
  "description": "Native bindings for cross-platform GPU texture sharing (Spout/Syphon)",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "texture-bridge",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ],
    "package": {
      "name": "@electron-texture-bridge/native"
    }
  },
  "scripts": {
    "build": "napi build --platform --release --js index.js --dts index.d.ts",
    "build:debug": "napi build --platform --js index.js --dts index.d.ts",
    "prepublish": "napi prepublish --skip-gh-release",
    "artifacts": "napi artifacts"
  },
  "keywords": ["napi-rs", "electron", "gpu", "spout", "syphon", "texture-sharing"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^25.2.0"
  },
  "optionalDependencies": {
    "@electron-texture-bridge/native-darwin-arm64": "0.1.0",
    "@electron-texture-bridge/native-darwin-x64": "0.1.0",
    "@electron-texture-bridge/native-win32-x64-msvc": "0.1.0"
  },
  "files": ["index.js", "index.d.ts"]
}
