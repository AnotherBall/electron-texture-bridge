{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "packages": {
    "packages/native": {
      "release-type": "node",
      "component": "native"
    },
    "packages/core": {
      "release-type": "node",
      "component": "core"
    },
    "packages/renderer": {
      "release-type": "node",
      "component": "renderer"
    }
  },
  "plugins": [
    {
      "type": "node-workspace",
      "updatePeerDependencies": true
    },
    {
      "type": "linked-versions",
      "groupName": "electron-texture-bridge",
      "components": ["native", "core", "renderer"]
    }
  ]
}
